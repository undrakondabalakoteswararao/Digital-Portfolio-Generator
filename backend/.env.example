# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/portfolioforge
# MongoDB Atlas example (replace user, password and cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolioforge?retryWrites=true&w=majority

# Long random string (at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Address of the React app (used for CORS)
CLIENT_URL=http://localhost:5173
